{
  "name": "kubelings-vscode",
  "displayName": "Kubelings - Learn Kubernetes by Doing",
  "description": "Interactive Kubernetes learning environment inside VS Code / Cursor.",
  "version": "0.15.0",
  "publisher": "dnf0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnf0/kubelings.git",
    "directory": "extensions/vscode"
  },
  "homepage": "https://dnf0.github.io/kubelings/",
  "bugs": {
    "url": "https://github.com/dnf0/kubelings/issues"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "kubernetes",
    "k8s",
    "devops",
    "learning",
    "interactive",
    "education"
  ],
  "main": "./dist/extension.js",
  "icon": "icons/icon.png",
  "activationEvents": [
    "onView:kubelings.curriculumView",
    "onLanguage:yaml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kubelings-view-container",
          "title": "Kubelings",
          "icon": "icons/kubelings-dark.svg"
        }
      ]
    },
    "views": {
      "kubelings-view-container": [
        {
          "id": "kubelings.curriculumView",
          "name": "Curriculum"
        }
      ]
    },
    "commands": [
      {
        "command": "kubelings.refresh",
        "title": "Kubelings: Refresh Curriculum",
        "icon": "$(refresh)"
      },
      {
        "command": "kubelings.openExercise",
        "title": "Kubelings: Open Exercise",
        "icon": "$(file-code)"
      },
      {
        "command": "kubelings.openSolution",
        "title": "Kubelings: Open Reference Solution",
        "icon": "$(file-code)"
      },
      {
        "command": "kubelings.resetExercise",
        "title": "Kubelings: Reset Current Exercise to Starter",
        "icon": "$(discard)"
      },
      {
        "command": "kubelings.initExercises",
        "title": "Kubelings: Initialize Exercises in Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "kubelings.runExercise",
        "title": "Kubelings: Run Current Exercise",
        "icon": "$(play)"
      },
      {
        "command": "kubelings.nextExercise",
        "title": "Kubelings: Open Next Exercise",
        "icon": "$(arrow-right)"
      },
      {
        "command": "kubelings.showHint",
        "title": "Kubelings: Show Hint",
        "icon": "$(lightbulb)"
      },
      {
        "command": "kubelings.showSolutionDiff",
        "title": "Kubelings: Compare with Reference Solution",
        "icon": "$(diff)"
      },
      {
        "command": "kubelings.startWatch",
        "title": "Kubelings: Start Watch Mode in Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "kubelings.checkCluster",
        "title": "Kubelings: Check Cluster Connection",
        "icon": "$(server-process)"
      },
      {
        "command": "kubelings.testAll",
        "title": "Kubelings: Test All Reference Solutions",
        "icon": "$(check-all)"
      },
      {
        "command": "kubelings.openWalkthrough",
        "title": "Kubelings: Open Interactive Walkthrough",
        "icon": "$(mortar-board)"
      }
    ],
    "walkthroughs": [
      {
        "id": "kubelings.walkthrough",
        "title": "Get Started with Kubelings ☸️",
        "description": "Master Kubernetes through hands-on, test-driven micro-exercises.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome & Curriculum Overview",
            "description": "walkthrough/welcome.md"
          },
          {
            "id": "cluster",
            "title": "Check Your Environment",
            "description": "walkthrough/cluster.md"
          },
          {
            "id": "watch",
            "title": "Interactive Watch Mode",
            "description": "walkthrough/watch.md"
          },
          {
            "id": "exercise",
            "title": "Solve First Exercise (pods01)",
            "description": "walkthrough/exercise.md"
          },
          {
            "id": "quickfixes",
            "title": "Diagnostics & Quick Fixes",
            "description": "walkthrough/quickfixes.md"
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kubelings.refresh",
          "when": "view == kubelings.curriculumView",
          "group": "navigation@1"
        },
        {
          "command": "kubelings.nextExercise",
          "when": "view == kubelings.curriculumView",
          "group": "navigation@2"
        },
        {
          "command": "kubelings.startWatch",
          "when": "view == kubelings.curriculumView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "kubelings.runExercise",
          "when": "view == kubelings.curriculumView && viewItem == exerciseItem",
          "group": "inline@1"
        },
        {
          "command": "kubelings.showHint",
          "when": "view == kubelings.curriculumView && viewItem == exerciseItem",
          "group": "1_actions@1"
        },
        {
          "command": "kubelings.showSolutionDiff",
          "when": "view == kubelings.curriculumView && viewItem == exerciseItem",
          "group": "1_actions@2"
        },
        {
          "command": "kubelings.openSolution",
          "when": "view == kubelings.curriculumView && viewItem == exerciseItem",
          "group": "1_actions@3"
        },
        {
          "command": "kubelings.resetExercise",
          "when": "view == kubelings.curriculumView && viewItem == exerciseItem",
          "group": "1_actions@4"
        }
      ]
    },
    "configuration": {
      "title": "Kubelings",
      "properties": {
        "kubelings.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the Python interpreter or virtual environment executable (leave blank for auto-detection)."
        },
        "kubelings.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run and validate exercise when saving an exercise file."
        },
        "kubelings.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Display Kubelings progress indicator in the status bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch-tsc": "tsc -watch -p ./",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npm run build && tsc -p ./ && node --test dist/test/*.test.js",
    "package": "npm run build && vsce package -o ../../dist/kubelings-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.3.3"
  }
}
